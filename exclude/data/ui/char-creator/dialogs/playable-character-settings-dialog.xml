<?xml version="1.0" encoding="utf-8"?>
<collapsible-dialog title="Playable Character Settings" width="400" height="400">
  <vbox width="100%" height="100%">
    <hbox width="100%" height="125">
      <frame text="Owned Characters" width="50%" height="100%">
        <scrollview id="ownedCharsView" contentWidth="100%" width="100%" height="100%" />
      </frame>
      <frame text="Background Texts" width="50%" height="100%">
        <vbox width="100%" height="100%">
          <textfield id="bgTextField1" placeholder="BOYFRIEND" width="100%" height="100%" />
          <textfield id="bgTextField2" placeholder="HOT BLOODED IN MORE WAYS THAN ONE" width="100%" height="100%" />
          <textfield id="bgTextField3" placeholder="PROTECT YO NUTS" width="100%" height="100%" />
        </vbox>
      </frame>
    </hbox>
  </vbox>
</collapsible-dialog>
